# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=syncmesh

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18113
BACKEND_PORT=19113
DB_PORT=17613

# ---- 数据库 ----
DB_NAME=syncmesh
DB_USER=syncmesh
DB_PASSWORD=syncmesh_pw_2026
DB_ADMIN_PASSWORD=postgres_admin_2026

# ---- 安全 ----
JWT_SECRET=syncmesh-jwt-secret-change-me-2026
API_KEY_PEPPER=syncmesh-api-key-pepper-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SOURCE_DIR=/data/sources
ARTIFACT_DIR=/data/artifacts
MAX_UPLOAD_MB=200
DEFAULT_MAX_CONCURRENT_RUNS=2
MOCK_REST_BASE_URL=http://backend:8000
SCHEDULER_POLL_SECONDS=30
SEED_DEMO=true
